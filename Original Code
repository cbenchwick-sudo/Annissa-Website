<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A. Neider Architecture</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;0,9..144,900;1,9..144,700;1,9..144,900&family=Outfit:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --cream: #F4EFE6;
  --ink: #111010;
  --violet: #5B3A8A;
  --lime: #C8F04A;
  --warm-gray: #E6E0D6;
  --mid: #7A7268;
  --light-violet: #EDE7F6;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;} .sqs-block-code,.sqs-block-content{padding:0!important;margin:0!important;}
html,body{padding:0!important;margin:0!important;overflow-x:hidden;}
html{scroll-behavior:smooth;}
body{background:var(--cream);color:var(--ink);font-family:'Outfit',sans-serif;overflow-x:hidden;margin:0;padding:0;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;justify-content:space-between;align-items:center;padding:1rem 2rem;background:transparent;backdrop-filter:none;border-bottom:none;transition:background 0.4s,backdrop-filter 0.4s,border-bottom 0.4s;}

nav.scrolled{background:rgba(244,239,230,0.97);backdrop-filter:blur(12px);border-bottom:1.5px solid rgba(17,16,16,0.1);}
.nav-logo img{height:44px;width:auto;display:block;mix-blend-mode:multiply;}
.nav-links{display:flex;gap:2rem;list-style:none;align-items:center;}
.nav-links a{font-size:0.82rem;font-weight:500;color:var(--ink);text-decoration:none;opacity:0.5;transition:opacity 0.2s;}
.nav-links a:hover{opacity:1;}
.nav-pill{background:var(--violet);color:#fff!important;opacity:1!important;padding:0.5rem 1.3rem;border-radius:99px;font-weight:700!important;font-size:0.78rem!important;transition:background 0.2s!important;}
.nav-pill:hover{background:var(--ink)!important;}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none;}
.hamburger span{display:block;width:24px;height:2px;background:var(--ink);border-radius:2px;transition:all 0.3s;}
.mobile-menu{display:none;position:fixed;top:70px;left:0;right:0;background:var(--cream);border-bottom:1.5px solid rgba(17,16,16,0.1);padding:1.5rem 2rem;z-index:199;flex-direction:column;gap:1.2rem;}
.mobile-menu.open{display:flex;}
.mobile-menu a{font-size:1rem;font-weight:600;color:var(--ink);text-decoration:none;padding:0.5rem 0;border-bottom:1px solid var(--warm-gray);}
.mobile-menu .mob-cta{background:var(--violet);color:#fff;padding:0.9rem 1.5rem;border-radius:99px;text-align:center;margin-top:0.5rem;border:none;font-weight:700;}

/* HERO */
.hero{min-height:100vh;padding:110px 2rem 4rem;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;}
.hero-top-bar{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:3rem;flex-wrap:wrap;gap:1rem;}
.hero-eyebrow{font-family:'DM Mono',monospace;font-size:0.65rem;letter-spacing:0.12em;color:var(--mid);text-transform:uppercase;}
.hero-cert-stack{display:flex;flex-direction:column;gap:0.4rem;align-items:flex-end;}
.pill{display:inline-block;padding:0.28rem 0.85rem;border-radius:99px;font-size:0.6rem;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;}
.pill-violet{background:var(--violet);color:#fff;}
.pill-lime{background:var(--lime);color:var(--ink);}
.pill-outline{border:1.5px solid rgba(17,16,16,0.25);color:var(--mid);}
.hero-title{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(3.8rem,10vw,10rem);line-height:0.95;letter-spacing:-0.03em;}
.ht-italic{font-style:italic;color:var(--violet);display:block;}
.ht-outlined{-webkit-text-stroke:2px var(--ink);color:transparent;}
.ht-highlight{display:inline-block;background:var(--lime);color:var(--ink);padding:0 0.1em;line-height:1.05;}
.hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;margin-top:3rem;gap:2rem;flex-wrap:wrap;}
.hero-sub{max-width:420px;font-size:0.95rem;line-height:1.75;color:var(--mid);font-weight:400;}
.hero-sub strong{color:var(--ink);font-weight:600;}
.hero-actions{display:flex;flex-direction:column;align-items:flex-end;gap:0.8rem;}
.btn-main{background:var(--violet);color:#fff;padding:0.95rem 2rem;border-radius:99px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.88rem;text-decoration:none;display:inline-block;transition:background 0.2s,transform 0.15s;white-space:nowrap;}
.btn-main:hover{background:var(--ink);transform:scale(1.03);}
.btn-sec{font-size:0.78rem;font-weight:500;color:var(--mid);text-decoration:none;display:flex;align-items:center;gap:0.35rem;transition:color 0.2s;}
.btn-sec:hover{color:var(--ink);}
.btn-sec::after{content:"→";}
.blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:0.22;pointer-events:none;}
.blob-1{width:400px;height:400px;background:var(--violet);top:5%;right:-8%;}
.blob-2{width:280px;height:280px;background:var(--lime);bottom:10%;left:10%;}

/* STATS BAND */
.stats-band{display:grid;grid-template-columns:2fr 1fr 1fr;border-top:1.5px solid var(--ink);border-bottom:1.5px solid var(--ink);}
.band-cell{padding:2rem 2.5rem;border-right:1.5px solid var(--ink);}
.band-cell:last-child{border-right:none;}
.band-cell.v{background:var(--violet);color:#fff;}
.band-cell.l{background:var(--lime);color:var(--ink);}
.band-lbl{font-family:'DM Mono',monospace;font-size:0.55rem;letter-spacing:0.2em;text-transform:uppercase;opacity:0.55;margin-bottom:0.5rem;display:block;}
.band-num{font-family:'Fraunces',serif;font-size:2.8rem;font-weight:900;line-height:1;margin-bottom:0.4rem;}
.band-desc{font-size:0.78rem;opacity:0.65;line-height:1.5;font-weight:400;}

/* SHARED */
.sec-wrap{padding:6rem 2rem;}
.sec-tag{font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--violet);margin-bottom:1rem;display:block;}
.sec-tag-light{color:var(--lime);}
.sec-h2{font-family:'Fraunces',serif;font-weight:900;line-height:0.95;letter-spacing:-0.025em;font-size:clamp(2.5rem,5.5vw,5rem);margin-bottom:3rem;}
.sec-h2 em{font-style:italic;color:var(--violet);}
.sec-h2-light em{color:var(--lime);}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start;}

/* ANNISSA */
.annissa-section{background:var(--ink);color:var(--cream);}
.annissa-photo{width:100%;aspect-ratio:4/5;border-radius:16px;overflow:hidden;}
.annissa-photo img{width:100%;height:100%;object-fit:contain;object-position:center center;display:block;background:#f5f0e8;}
.annissa-name{font-family:'Fraunces',serif;font-size:clamp(2.2rem,4vw,3.8rem);font-weight:900;line-height:1;letter-spacing:-0.02em;margin-bottom:0.4rem;color:var(--cream);}
.annissa-name em{font-style:italic;color:var(--lime);}
.annissa-cred-line{font-family:'DM Mono',monospace;font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--lime);margin-bottom:0.3rem;opacity:0.8;}
.annissa-title-line{font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:#555;margin-bottom:2rem;}
.annissa-bio{font-size:0.92rem;line-height:1.85;color:#aaa;margin-bottom:1rem;font-weight:300;}
.annissa-bio strong{color:var(--cream);font-weight:600;}

/* Annissa pillars */
.annissa-pillars{display:flex;flex-direction:column;gap:0;margin-top:1.8rem;border:1px solid #222;border-radius:14px;overflow:hidden;}
.pillar{padding:1.4rem 1.6rem;border-bottom:1px solid #1e1e1e;transition:background 0.2s;}
.pillar:last-child{border-bottom:none;}
.pillar:hover{background:#181818;}
.pillar-title{font-family:'Outfit',sans-serif;font-size:0.8rem;font-weight:700;color:var(--lime);margin-bottom:0.4rem;display:flex;align-items:center;gap:0.5rem;}
.pillar-title::before{content:'';display:inline-block;width:6px;height:6px;background:var(--lime);border-radius:50%;flex-shrink:0;}
.pillar-body{font-size:0.8rem;line-height:1.65;color:#888;font-weight:300;}

/* Credentials strip */
.cred-strip{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#1e1e1e;border:1px solid #1e1e1e;border-radius:12px;overflow:hidden;margin-top:1.5rem;}
.cred-box{background:#161616;padding:1.2rem 1.5rem;}
.cred-box.hi{background:var(--violet);}
.cred-lbl{font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.2em;text-transform:uppercase;color:#444;margin-bottom:0.35rem;display:block;}
.cred-box.hi .cred-lbl{color:rgba(255,255,255,0.5);}
.cred-val{font-size:0.8rem;font-weight:600;color:var(--cream);line-height:1.3;}
.cred-box.hi .cred-val{color:#fff;}

/* ABOUT */
.about-section{background:var(--cream);}
.about-copy{font-size:0.92rem;line-height:1.85;color:var(--mid);margin-bottom:1.2rem;font-weight:400;}
.about-copy strong{color:var(--ink);font-weight:600;}
.wbe-card{background:var(--violet);color:#fff;padding:1.8rem 2rem;border-radius:14px;margin-top:1.8rem;}
.wbe-card-lbl{font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.2em;text-transform:uppercase;opacity:0.6;margin-bottom:0.6rem;display:block;}
.wbe-card h3{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:900;margin-bottom:0.6rem;}
.wbe-card p{font-size:0.82rem;line-height:1.65;opacity:0.82;font-weight:400;}
.cert-tags{display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:1rem;}
.cert-tag{background:rgba(255,255,255,0.15);font-size:0.58rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;padding:0.25rem 0.65rem;border-radius:99px;}
.feature-stack{display:flex;flex-direction:column;border:1.5px solid var(--ink);border-radius:18px;overflow:hidden;}
.feat-row{display:flex;align-items:flex-start;gap:1.2rem;padding:1.6rem 1.8rem;border-bottom:1.5px solid var(--ink);transition:background 0.2s;}
.feat-row:last-child{border-bottom:none;}
.feat-row:hover{background:var(--warm-gray);}
.feat-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.fi-v{background:var(--light-violet);} .fi-l{background:#edfac0;} .fi-c{background:#ffe4dd;} .fi-s{background:#dff0ff;}
.feat-row h4{font-size:0.92rem;font-weight:700;margin-bottom:0.25rem;}
.feat-row p{font-size:0.78rem;line-height:1.55;color:var(--mid);font-weight:400;}

/* PROJECT CARDS */
.projects-section{background:var(--warm-gray);border-top:1.5px solid var(--ink);border-bottom:1.5px solid var(--ink);}
.proj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;}
.proj-card{background:var(--cream);border:1.5px solid var(--ink);border-radius:16px;overflow:hidden;transition:transform 0.25s,box-shadow 0.25s;}
.proj-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,0.1);}
.proj-art{width:100%;height:180px;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.art-hangar{background:#0e0e14;} .art-commercial{background:#0f0e14;} .art-industrial{background:#0c1008;}
.proj-body{padding:1.6rem;}
.proj-num{font-family:'DM Mono',monospace;font-size:0.55rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--mid);margin-bottom:0.6rem;display:block;}
.proj-title{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:900;margin-bottom:0.5rem;}
.proj-desc{font-size:0.8rem;line-height:1.6;color:var(--mid);font-weight:400;}

/* SERVICES — 3-column cards */
.services-section{background:var(--ink);color:var(--cream);}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-bottom:2rem;}
.svc-card{background:#161616;border:1px solid #222;border-radius:16px;padding:2rem 1.8rem;transition:border-color 0.2s,transform 0.2s;}
.svc-card:hover{border-color:var(--violet);transform:translateY(-3px);}
.svc-card-icon{width:44px;height:44px;border-radius:12px;background:#1e1e1e;display:flex;align-items:center;justify-content:center;margin-bottom:1.2rem;}
.svc-card-title{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:900;margin-bottom:1.2rem;color:var(--cream);}
.svc-list-items{list-style:none;display:flex;flex-direction:column;gap:0.6rem;}
.svc-list-items li{font-size:0.78rem;line-height:1.5;color:#888;font-weight:400;display:flex;align-items:flex-start;gap:0.5rem;}
.svc-list-items li::before{content:'—';color:var(--violet);font-size:0.7rem;margin-top:0.05em;flex-shrink:0;}
.svc-note{display:flex;align-items:flex-start;gap:0.75rem;background:#111;border:1px solid #1e1e1e;border-radius:10px;padding:1.2rem 1.5rem;font-size:0.78rem;line-height:1.6;color:#666;font-weight:400;}
.svc-note svg{flex-shrink:0;margin-top:0.1rem;opacity:0.6;}

/* PROCESS */
.process-section{background:var(--cream);}
.proc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem;}
.proc-card{background:var(--warm-gray);border-radius:14px;padding:2rem 1.6rem;border:1.5px solid transparent;transition:transform 0.2s,box-shadow 0.2s,border-color 0.2s;}
.proc-card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,0.08);border-color:var(--violet);}
.proc-card.v{background:var(--violet);color:#fff;border-color:var(--violet);}
.proc-num{font-family:'DM Mono',monospace;font-size:0.54rem;letter-spacing:0.2em;text-transform:uppercase;opacity:0.45;margin-bottom:1.5rem;display:block;}
.proc-arrow{font-size:1.5rem;margin-bottom:0.8rem;display:block;opacity:0.3;}
.proc-title{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:900;margin-bottom:0.7rem;}
.proc-desc{font-size:0.78rem;line-height:1.6;opacity:0.6;font-weight:400;}

/* GALLERY */
.gallery-section{background:var(--ink);color:var(--cream);}
.gallery-intro{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:end;margin-bottom:3rem;}
.gallery-intro p{font-size:0.85rem;line-height:1.75;color:#888;font-weight:400;}
.gallery-grid{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:250px 200px;gap:8px;}
.g-item{perspective:1200px;border-radius:8px;cursor:pointer;}
.g-item:first-child{grid-row:1/3;}
.g-flipper{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform 0.75s cubic-bezier(0.4,0.2,0.2,1);}
.g-item:hover .g-flipper{transform:rotateY(180deg);}
.g-front,.g-back{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:8px;overflow:hidden;}
.g-front img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;filter:grayscale(100%) contrast(1.1);}
.g-front-label{position:absolute;bottom:0;left:0;right:0;padding:0.8rem 1rem;background:linear-gradient(to top,rgba(0,0,0,0.55),transparent);}
.g-front-label span{font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.4);}
.g-back{transform:rotateY(180deg);display:flex;flex-direction:column;justify-content:flex-end;padding:1.6rem 1.4rem;}
.g-back img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block;filter:saturate(1.2) contrast(1.05);}
.g-back-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(17,16,16,0.88) 40%,rgba(17,16,16,0.1) 100%);}
.g-back-content{position:relative;z-index:2;}
.g-back-tag{font-family:'DM Mono',monospace;font-size:0.5rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--lime);margin-bottom:0.5rem;display:block;}
.g-back-title{font-family:'Fraunces',serif;font-size:1.05rem;font-weight:900;color:var(--cream);line-height:1.2;margin-bottom:0.5rem;}
.g-back-desc{font-size:0.72rem;line-height:1.6;color:rgba(244,239,230,0.65);font-weight:300;}
.gallery-note{font-family:'DM Mono',monospace;font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:#3a3a3a;margin-top:1.5rem;}

/* STATEMENT */
.statement-section{background:var(--lime);padding:5rem 2rem;border-top:1.5px solid var(--ink);border-bottom:1.5px solid var(--ink);text-align:center;}
.statement-section h2{font-family:'Fraunces',serif;font-size:clamp(2.8rem,7vw,7rem);font-weight:900;color:var(--ink);line-height:0.95;letter-spacing:-0.03em;}
.statement-section h2 .outline{-webkit-text-stroke:3px var(--ink);color:transparent;}
.statement-section h2 em{font-style:italic;}
.statement-section p{font-family:'DM Mono',monospace;font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--ink);opacity:0.4;margin-top:1.2rem;}

/* TESTIMONIALS */
.testi-section{background:var(--cream);border-top:1.5px solid var(--ink);}
.testi-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;}
.testi-card{background:var(--warm-gray);border-radius:18px;padding:2.5rem 2.2rem;border:1.5px solid transparent;transition:border-color 0.2s,transform 0.2s;}
.testi-card:hover{border-color:var(--violet);transform:translateY(-3px);}
.testi-card.feat{background:var(--violet);color:#fff;}
.testi-stars{font-size:0.78rem;letter-spacing:0.1em;color:var(--violet);margin-bottom:1rem;}
.testi-card.feat .testi-stars{color:var(--lime);}
.testi-quote{font-family:'Fraunces',serif;font-size:0.9rem;line-height:1.85;font-style:italic;margin-bottom:1.5rem;opacity:0.88;font-weight:400;}
.testi-author{font-size:0.8rem;font-weight:700;margin-bottom:0.2rem;}
.testi-role{font-size:0.7rem;opacity:0.45;font-weight:400;}

/* CONTACT */
.contact-section{background:var(--cream);padding:6rem 2rem;border-top:1.5px solid var(--ink);display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start;width:100%;box-sizing:border-box;}
.contact-left p{font-size:0.9rem;line-height:1.8;color:var(--mid);margin-bottom:2rem;font-weight:400;}
.cdr{display:flex;justify-content:space-between;align-items:flex-start;padding:0.85rem 0;border-bottom:1.5px solid var(--warm-gray);gap:1rem;}
.cdr-l{font-family:'DM Mono',monospace;font-size:0.54rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--mid);white-space:nowrap;margin-top:0.1rem;}
.cdr-v{font-size:0.83rem;font-weight:600;color:var(--ink);text-decoration:none;transition:color 0.2s;text-align:right;}
.cdr-v:hover{color:var(--violet);}
.contact-form{display:flex;flex-direction:column;width:100%;}
.f-row{padding:0.9rem 0;border-bottom:1.5px solid rgba(17,16,16,0.15);display:flex;flex-direction:column;gap:0.3rem;transition:border-color 0.2s;}
.f-row:focus-within{border-color:var(--violet);}
.f-row label{font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--mid);}
.f-row input,.f-row textarea,.f-row select{background:transparent;border:none;outline:none;font-family:'Outfit',sans-serif;font-size:0.92rem;color:var(--ink);font-weight:500;resize:none;width:100%;box-sizing:border-box;}
.f-row input::placeholder,.f-row textarea::placeholder{color:#bdb6aa;}
.f-row select option{background:var(--cream);}
.btn-submit{margin-top:1.8rem;background:var(--violet);color:#fff;border:none;padding:0.95rem 2rem;border-radius:99px;font-family:'Outfit',sans-serif;font-size:0.88rem;font-weight:700;cursor:pointer;align-self:flex-start;transition:background 0.2s,transform 0.15s;}
.btn-submit:hover{background:var(--ink);transform:scale(1.03);}

/* FOOTER */
footer{background:var(--ink);color:var(--cream);padding:2.5rem 2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;width:100%;box-sizing:border-box;}
.f-logo img{height:36px;width:auto;display:block;filter:brightness(0) invert(1);}
footer p{font-family:'DM Mono',monospace;font-size:0.56rem;letter-spacing:0.1em;color:#3a3a3a;}
.f-certs{display:flex;gap:0.5rem;flex-wrap:wrap;}
.f-cert{background:#1a1a1a;font-family:'DM Mono',monospace;font-size:0.52rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.25rem 0.65rem;border-radius:99px;color:#4a4a4a;}

/* REVEAL */
.reveal{opacity:0;transform:translateY(22px);transition:opacity 0.65s ease,transform 0.65s ease;}
.reveal.in{opacity:1;transform:translateY(0);}

/* MOBILE */
@media(max-width:768px){
  .nav-links{display:none;}
  .hamburger{display:flex;}
  .hero{padding:100px 1.5rem 3rem;min-height:auto;}
